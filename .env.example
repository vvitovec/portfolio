# Database
DATABASE_URL="postgresql://user:password@host:6543/db?pgbouncer=true&connection_limit=1&sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=verify-full"

# DEV-only: ignored in production
PRISMA_PG_ACCEPT_SELF_SIGNED=false
# Alternative flag (also ignored in production)
# PG_SSL_REJECT_UNAUTHORIZED=false

# Auth (GitHub OAuth)
GITHUB_ID=""
GITHUB_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Prefer stable numeric GitHub account IDs. If empty, the app falls back to ADMIN_GITHUB_LOGINS.
ADMIN_GITHUB_IDS="123456,789012"
ADMIN_GITHUB_LOGINS="login1,login2"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Self-hosted storage fallback for admin/CLI uploads
SELF_HOSTED_STORAGE_BASE_URL=""
SELF_HOSTED_STORAGE_SERVICE_KEY=""
SELF_HOSTED_STORAGE_BUCKET=""

# Internal cache revalidation for portfolio publishing CLI
PORTFOLIO_REVALIDATE_SECRET=""
PORTFOLIO_REVALIDATE_BASE_URL="https://www.vvitovec.com"

# Contact form email
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="Portfolio Contact <blog@vvitovec.com>"

# Blog newsletter email
NEWSLETTER_BASE_URL="https://www.vvitovec.com"
NEWSLETTER_FROM_EMAIL="Viktor Vitovec Blog <blog@vvitovec.com>"
NEWSLETTER_REPLY_TO_EMAIL="blog@vvitovec.com"
NEWSLETTER_HASH_SECRET=""

# OpenAI
OPENAI_API_KEY="replace_me"
OPENAI_TRANSLATE_MODEL="gpt-4o-mini"
