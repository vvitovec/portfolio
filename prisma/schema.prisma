generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum Locale {
  cs
  en
}

enum NewsletterSubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum NewsletterEmailType {
  CONFIRMATION
  BLOG_POST
}

enum NewsletterEmailStatus {
  SENT
  FAILED
}

enum NewsletterPostSendStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CommentTargetType {
  BLOG_POST
  PROJECT
}

enum CommentStatus {
  VISIBLE
  PENDING_REVIEW
  BLOCKED
  HIDDEN
  DELETED
}

enum CommentModerationStatus {
  PASSED
  FLAGGED
  BLOCKED
  UNCHECKED
}

model Project {
  id       String        @id @default(cuid())
  slug     String        @unique
  status   ProjectStatus @default(DRAFT)
  featured Boolean       @default(false)
  year     Int?

  coverImageUrl    String?
  galleryImageUrls String[] @default([])
  liveUrl          String?
  repoUrl          String?

  techStack String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  translations   ProjectTranslation[]
  commentThreads CommunityThread[]
}

model ProjectTranslation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  locale           Locale
  title            String
  tagline          String?
  descriptionShort String?
  descriptionLong  String?
  caseStudyBlocks  Json    @default("[]")

  role       String?
  highlights String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, locale])
  @@index([locale])
}

model Website {
  id          String        @id @default(cuid())
  name        String
  url         String
  category    String
  description String?
  sortOrder   Int           @default(0)
  status      WebsiteStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
}

model BlogPost {
  id       String         @id @default(cuid())
  slug     String         @unique
  status   BlogPostStatus @default(DRAFT)
  featured Boolean        @default(false)
  tags     String[]       @default([])

  coverImageUrl       String?
  coverImageCredit    String?
  coverImageCreditUrl String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  translations          BlogPostTranslation[]
  newsletterSends       NewsletterPostSend[]
  newsletterEmailEvents NewsletterEmailEvent[]
  commentThreads        CommunityThread[]
}

model BlogPostTranslation {
  id     String   @id @default(cuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  locale            Locale
  title             String
  excerpt           String?
  contentMarkdown   String
  seoTitle          String?
  seoDescription    String?
  coverImageAlt     String?
  coverImageCaption String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, locale])
  @@index([locale])
}

model NewsletterSubscriber {
  id     String                     @id @default(cuid())
  email  String                     @unique
  locale Locale                     @default(en)
  status NewsletterSubscriberStatus @default(PENDING)
  source String?

  confirmationTokenHash String? @unique
  unsubscribeToken      String  @unique

  ipHash    String?
  userAgent String?

  consentAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  lastSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailEvents NewsletterEmailEvent[]

  @@index([status])
  @@index([locale])
  @@index([createdAt])
}

model NewsletterPostSend {
  id     String                   @id @default(cuid())
  postId String
  post   BlogPost                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  status NewsletterPostSendStatus

  recipientCount Int     @default(0)
  sentCount      Int     @default(0)
  failedCount    Int     @default(0)
  errorMessage   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  emailEvents NewsletterEmailEvent[]

  @@index([postId])
  @@index([status])
  @@index([createdAt])
}

model NewsletterEmailEvent {
  id           String                @id @default(cuid())
  subscriberId String?
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  postId       String?
  post         BlogPost?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  postSendId   String?
  postSend     NewsletterPostSend?   @relation(fields: [postSendId], references: [id], onDelete: SetNull)

  type   NewsletterEmailType
  status NewsletterEmailStatus

  toEmail       String
  subject       String
  resendEmailId String?
  errorMessage  String?

  createdAt DateTime @default(now())

  @@index([subscriberId])
  @@index([postId])
  @@index([postSendId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model CommunityThread {
  id         String            @id @default(cuid())
  targetType CommentTargetType
  targetSlug String

  blogPostId String?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title         String
  lastCommentAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments Comment[]

  @@unique([targetType, targetSlug])
  @@index([targetType])
  @@index([targetSlug])
  @@index([blogPostId])
  @@index([projectId])
  @@index([lastCommentAt])
}

model Comment {
  id       String          @id @default(cuid())
  threadId String
  thread   CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  authorName String?
  body       String
  isAdmin    Boolean       @default(false)
  status     CommentStatus @default(VISIBLE)

  moderationStatus     CommentModerationStatus @default(UNCHECKED)
  moderationSource     String?
  moderationReason     String?
  moderationCategories Json?
  moderationCheckedAt  DateTime?

  ipHash    String?
  userAgent String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([threadId])
  @@index([parentId])
  @@index([status])
  @@index([isAdmin])
  @@index([ipHash])
  @@index([createdAt])
}

model CommentIpBlock {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
}
